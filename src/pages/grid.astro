---
import Base from "../layouts/Base.astro";

// vinyl
import Album from "../components/vinyl/Album.astro";
import GridableAlbum from "../components/vinyl/GridableAlbum.astro";

import albumsJson from "../data/albums.json";
---

<Base>
  <div class="mx-auto w-max bg-black p-6">
    {
      albumsJson.albums.map((album, number) => (
        <GridableAlbum number={++number} img={album.img} artist={album.artist} name={album.name} />
      ))
    }
  </div>
</Base>
